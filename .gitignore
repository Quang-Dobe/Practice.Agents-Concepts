# ---------------------------------------------------------------------------
# Learning repo .gitignore
# Covers: .NET (C#), TypeScript/React/Node, Python, SQL tooling, IaC,
# IDEs (VS / Rider / VS Code), OS files, and Claude Code local settings.
# Committed by intent: .claude/agents, .claude/commands, .claude/skills,
# .claude/CLAUDE.md, and every docs/ + code/ folder inside topic folders.
# ---------------------------------------------------------------------------


# === .NET / C# =============================================================
# Build output
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# Visual Studio
.vs/
*.vspscc
*.vssscc

# Rider / ReSharper
.idea/
*.DotSettings.user
_ReSharper*/
*.[Rr]e[Ss]harper

# Test results / coverage
[Tt]est[Rr]esult*/
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
*.opencover.xml

# NuGet
*.nupkg
*.snupkg
.nuget/
**/packages/*
!**/packages/build/
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET / EF
appsettings.*.local.json
*.pfx
*.publishsettings
PublishProfiles/
Migrations/*.Designer.cs.bak


# === Node / TypeScript / React ============================================
node_modules/
.pnp
.pnp.js
.pnp.cjs
.yarn/cache
