<Project Sdk="Microsoft.NET.Sdk">

  <!-- One flat console app, like database/mvcc and database/two-phase-commit.
       The lesson is "which anomaly shows up at which level", not the layering,
       so there are no Clean Architecture projects here.
       Zero NuGet packages: the "database" is a ~60-line in-process simulation,
       so no server, no Docker. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets the demo run on a newer runtime if only .NET 9/10 is installed. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

</Project>
